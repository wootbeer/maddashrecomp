@@ -2308,6 +2314,8 @@ BOOL xbox_MemoryLayoutInit(const void *xbe_data, size_t xbe_size)
         #undef MEM32_INIT
         #undef XBOX_VA
     }
+    if (g_reload)
+        goto reload_done;       /* the windows below are mapped already */
 
     /*
      * Contiguous / physical memory window at 0x80000000.
@@ -2736,6 +2744,7 @@ BOOL xbox_MemoryLayoutInit(const void *xbe_data, size_t xbe_size)
     }
 
     xbox_WatchInit();
+reload_done:
     fprintf(stderr, "xbox_MemoryLayoutInit: complete\n");
