 }
@@ -3703,3 +3712,57 @@ HANDLE xbox_GetMappingHandle(void)
 {
     return g_mapping_handle;
 }
+
+/* Load the image again into the mapping already made, as at start-up: RAM,
+ * the contiguous window and the heap's overflow area zeroed, every allocator
+ * empty, the sections, stack, TIB and TLS block as xbox_MemoryLayoutInit
+ * leaves them. For a warm reboot (xbox_kernel_reboot_begin in
+ * kernel_bridge.c, which keeps every other guest thread out meanwhile).
+ * The NV2A, MCPX and flash apertures keep their contents, as hardware
+ * registers would across a reboot.
+ *
+ * ponytail: RECOMP_EXT_VMA's tracker (guest_vmem.c) is not reset; a title
+ * using it would see the old boot's reservations. */
+BOOL xbox_MemoryLayoutReload(const void *xbe_data, size_t xbe_size)
+{
+    size_t lo = getenv("RECOMP_TRAP_NULL") ? 0x1000 : 0;
+    BOOL ok;
+
+    if (!g_memory_base)
+        return FALSE;
+    memset((uint8_t *)g_memory_base + lo, 0, g_memory_size - lo);
+    if (g_contig_memory)
+        memset(g_contig_memory, 0, XBOX_CONTIG_SIZE);
+
+    AcquireSRWLockExclusive(&g_heap_lock);
+    g_heap_block_count = 0;
+    g_heap_alloc_count = 0;
+    g_thread_stacks_used = 0;
+    memset(g_thread_stack_sizes, 0, sizeof g_thread_stack_sizes);
+    if (g_ovf_count) {
+        memset((void *)((uintptr_t)g_ovf_lo + g_memory_offset), 0, HEAP_OVF_SIZE);
+        g_ovf[0].addr = g_ovf_lo;
+        g_ovf[0].size = HEAP_OVF_SIZE;
+        g_ovf[0].free = 1;
+        g_ovf_count = 1;
+    }
+    ReleaseSRWLockExclusive(&g_heap_lock);
+
+    AcquireSRWLockExclusive(&g_contig_lock);
+    g_contig_next = XBOX_CONTIG_BASE + 0x1000u;
+    g_contig_block_count = 0;
+    ReleaseSRWLockExclusive(&g_contig_lock);
+    g_reserve_next = 0;
+
+    g_reload = 1;
+    ok = xbox_MemoryLayoutInit(xbe_data, xbe_size);
+    g_reload = 0;
+    return ok;
+}
+
+/* The calling thread's setjmp buffers belong to frames a warm reboot has
+ * unwound (xbox_kernel_reboot_end). */
+void recomp_jmp_reset(void)
+{
+    s_jmp_used = 0;
+}
