+/* ── Warm reboot ──────────────────────────────────────────
+ *
+ * A title that loads its levels by launching itself again (XLaunchNewImage,
+ * then HalReturnToFirmware) reboots the console each time. Done as a new
+ * process, the window closes and opens on every load. xbox_kernel_reboot_begin
+ * and _end let a host do it in place instead, on the thread that asked:
+ *
+ *   xbox_kernel_reboot_begin();       take the guest CPU, forget the boot's objects
+ *   xbox_MemoryLayoutReload(xbe, n);  memory and allocators as at start-up
+ *   xbox_kernel_bridge_init();        kernel data and thunks again
+ *   (launch data page back in place)
+ *   xbox_kernel_reboot_end();         the calling thread is the new boot's
+ *   ... and run the entry point again, from a stack the host unwound.
+ *
+ * The other guest threads of the old boot are not stopped (a host thread
+ * cannot be stopped safely in the middle of a call); each parks the next time
+ * it would run guest code (guest_cpu_acquire), and the host objects it waits
+ * on are left alone. The guest CPU lock (RECOMP_GUEST_LOCK=1) is required: it
+ * is what keeps them out while memory is reset.
+ *
+ * Forgotten, not destroyed: Ke object shadows, open files and handles stay
+ * with the threads that may still wait on them, a few host handles per boot.
+ * A lock a parked thread still holds keeps its table slot.
+ *
+ * ponytail: a thread created moments before the reboot that has not reached
+ * guest_cpu_join yet joins the new boot and runs its routine there. */
+void xbox_cs_table_reboot(void);        /* kernel_rtl.c */
+void xbox_symlinks_reboot(void);        /* kernel_io.c */
+void recomp_jmp_reset(void);            /* xbox_memory_layout.c */
+
+int xbox_kernel_reboot_begin(void)
+{
+    int i;
+
+    if (!guest_cpu_enabled())
+        return 0;
+    if (!t_guest_held) {
+        EnterCriticalSection(&g_guest_cpu);
+        t_guest_held = 1;
+    }
+
+    g_thread_call_count = 0;            /* the next first thread is the title's main one */
+    g_spawn_kthread = 0;
+
+    if (g_timer_started) {
+        EnterCriticalSection(&g_timer_lock);
+        memset(g_timers, 0, sizeof g_timers);
+        LeaveCriticalSection(&g_timer_lock);
+    }
+    dpc_lock();
+    g_dpc_head = g_dpc_tail = 0;
+    LeaveCriticalSection(&g_dpc_lock);
+    memset(g_connected_isr, 0, sizeof g_connected_isr);
+
+    ke_shadow_init();
+    EnterCriticalSection(&g_ke_shadow_cs);
+    memset(g_ke_shadow, 0, sizeof g_ke_shadow);     /* handles left to their waiters */
+    LeaveCriticalSection(&g_ke_shadow_cs);
+
+    bridge_try_cs_init_guard();
+    EnterCriticalSection(&g_try_cs_guard);
+    for (i = 0; i < BRIDGE_TRY_CS_SLOTS; i++) {
+        BRIDGE_TRY_CS_SLOT *slot = &g_try_cs[i];
+        if (!slot->key)
+            continue;
+        if (slot->ready && TryEnterCriticalSection(&slot->cs)) {
+            LeaveCriticalSection(&slot->cs);
+            slot->key = 0;              /* free; the lock is reused as it is */
+        } else {
+            slot->key = 1;              /* held by a parked thread: never matches */
+        }
+    }
+    LeaveCriticalSection(&g_try_cs_guard);
+
+    memset(s_ethreads, 0, sizeof s_ethreads);
+    memset(g_async_handles, 0, sizeof g_async_handles);
+    memset(g_part_handles, 0, sizeof g_part_handles);
+    xbox_cs_table_reboot();
+    xbox_symlinks_reboot();
+    fprintf(stderr, "  [KERNEL] reboot: boot %ld ends\n", (long)g_xbox_boot_gen);
+    return 1;
+}
+
+void xbox_kernel_reboot_end(void)
+{
+    InterlockedIncrement(&g_xbox_boot_gen);
+    t_boot_gen = g_xbox_boot_gen;
+    t_guest_thread = 1;
+    t_dispatch_depth = 0;
+    g_kernel_dispatch_slot = -1;
+    g_is_spawned_thread = 0;
+    g_thread_stack_top = 0;
+    recomp_jmp_reset();
+    fprintf(stderr, "  [KERNEL] reboot: boot %ld starts\n", (long)g_xbox_boot_gen);
+}
