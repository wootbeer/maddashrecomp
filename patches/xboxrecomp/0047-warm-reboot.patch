+ * launch data back and calls end, after which the calling thread is the new
+ * boot's and holds the guest CPU. Other threads of the old boot park.
+ * begin returns 0, changing nothing, without RECOMP_GUEST_LOCK=1. */
+int  xbox_kernel_reboot_begin(void);
+void xbox_kernel_reboot_end(void);
