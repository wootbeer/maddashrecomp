+
+/* ---------------------------------------------------------------------------
+ * cpuid, pushfd, popfd: see recomp_types.h.
+ * ------------------------------------------------------------------------- */
+
+extern RECOMP_TLS int g_df;
+
+/* EFLAGS' system bits as the guest last set them: ID (21), AC (18), IF (9);
+ * IF reads 1, as in user code. Bit 1 always reads 1. */
+static RECOMP_TLS uint32_t t_eflags_sys = 0x00000200u;
+#define EFLAGS_SYS_MASK 0x00240200u
+
+uint32_t recomp_eflags_read(void)
+{
+    return 0x00000002u | t_eflags_sys | (g_df ? 0x00000400u : 0);
+}
+
+void recomp_eflags_write(uint32_t value)
+{
+    t_eflags_sys = (value & EFLAGS_SYS_MASK) | 0x00000200u;
+    g_df = (value & 0x00000400u) != 0;
+}
+
+void recomp_cpuid(void)
+{
+    switch (g_eax) {
+    case 0:                 /* highest leaf, "GenuineIntel" */
+        g_eax = 2;
+        g_ebx = 0x756E6547u;
+        g_edx = 0x49656E69u;
+        g_ecx = 0x6C65746Eu;
+        break;
+    case 1:                 /* family 6 model 8 stepping 10 */
+        g_eax = 0x0000068Au;
+        g_ebx = 0;
+        g_ecx = 0;
+        /* FPU VME DE PSE TSC MSR PAE MCE CX8 SEP MTRR PGE MCA CMOV PAT
+         * PSE36 MMX FXSR SSE */
+        g_edx = 0x0383F9FFu;
+        break;
+    case 2:                 /* cache descriptors: 128 KB L2, 16 KB L1s */
+        g_eax = 0x03020101u;
+        g_ebx = 0;
+        g_ecx = 0;
+        g_edx = 0x0C040841u;
+        break;
+    default:
+        g_eax = g_ebx = g_ecx = g_edx = 0;
+        break;
+    }
+}
