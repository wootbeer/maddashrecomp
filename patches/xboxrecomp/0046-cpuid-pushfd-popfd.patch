+/* cpuid, pushfd and popfd (src/kernel/recomp_trace.c). cpuid answers as
+ * the Xbox's processor, a Pentium III-class Celeron (GenuineIntel, family
+ * 6, model 8: MMX, SSE, CMOV). pushfd/popfd carry EFLAGS' system bits (ID,
+ * AC, IF) and DF through the stack; the arithmetic flags are tracked by the
+ * lifter per comparison and are not in the pushed word. That is what the
+ * CPUID-availability check needs (toggle bit 21, see whether it stays): a
+ * title's CPU check -- Bink's, before choosing its decoder routines --
+ * otherwise read whatever the registers held. */
+void recomp_cpuid(void);
+uint32_t recomp_eflags_read(void);
+void recomp_eflags_write(uint32_t value);
